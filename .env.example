# ── Copy to .env and fill in. Never commit .env. ───────────────────────────
NODE_ENV=production
PORT=8080
# Exact public origin users type in the browser (used for CSRF Origin checks).
PUBLIC_ORIGIN=https://signal.example.com

# 32 random bytes. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates the stored Kite token (you will just reconnect).
TOKEN_ENC_KEY=

# live = real Kite Connect, mock = deterministic synthetic market (demo / dev)
KITE_MODE=live
KITE_API_KEY=
KITE_API_SECRET=

# Candle timeframe: minute | 3minute | 5minute | 10minute | 15minute | 30minute | 60minute
TIMEFRAME=15minute
LIVE_ENABLED=true

SESSION_TTL_HOURS=12
# Set true when behind Caddy / Cloudflare so client IPs are correct for rate limiting.
TRUST_PROXY=true

# Daily SQLite snapshots in $DATA_DIR/backups (keeps the newest N).
BACKUP_ENABLED=true
BACKUP_KEEP=14

LOG_LEVEL=info

# docker compose profiles
CLOUDFLARE_TUNNEL_TOKEN=
SIGNAL_DOMAIN=signal.example.com
